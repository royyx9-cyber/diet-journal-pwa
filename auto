name: Auto Sync from Google Drive
on:
  schedule:
    - cron: '0 * * * *' # 每小時自動同步一次
  workflow_dispatch:     # 亦支援手動觸發
jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Download latest index.html
        run: |
          curl -sL "https://drive.google.com/uc?export=download&id=您的檔案ID" -o index.html
      - name: Commit and Push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add index.html
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto sync latest PWA version" && git push)
